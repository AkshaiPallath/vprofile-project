pipeline{
    agent any

    tools{
        jdk "JDK17"
        maven "Maven3"
    }
    
    stages{
        stage('Maven Build'){
            steps{
                sh'mvn clean install'
            }
            post{
                 success {
                    archiveArtifacts artifacts: '**/*.war'
                }
            }
        }
    }
    
}